<UserControl
    x:Class="ImageHandle.Scripts.ScriptUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ImageHandle.Scripts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Width="160"
    Height="40"
    MinWidth="160"
    MinHeight="40"
    d:DesignHeight="40"
    d:DesignWidth="160"
    Background="Transparent"
    MouseDown="UserControl_MouseDown"
    MouseMove="UserControl_MouseMove"
    MouseUp="UserControl_MouseUp"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ConnectorStroke" Color="White" />
        <sys:Double x:Key="ConnectorSize">5</sys:Double>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <!--  边框  -->
        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Gray"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="10" />
        <!--  中心点圆形  -->
        <Grid>
            <!--  顶部中心  -->
            <Ellipse
                x:Name="TopConnector"
                Width="{StaticResource ConnectorSize}"
                Height="{StaticResource ConnectorSize}"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Cursor="Hand"
                Fill="Transparent"
                MouseLeftButtonDown="Connector_MouseDown"
                Stroke="{StaticResource ConnectorStroke}"
                StrokeThickness="1" />

            <!--  底部中心  -->
            <Ellipse
                x:Name="BottomConnector"
                Width="{StaticResource ConnectorSize}"
                Height="{StaticResource ConnectorSize}"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Cursor="Hand"
                Fill="Transparent"
                MouseLeftButtonDown="Connector_MouseDown"
                Stroke="{StaticResource ConnectorStroke}"
                StrokeThickness="1" />

            <!--  左侧中心  -->
            <Ellipse
                x:Name="LeftConnector"
                Width="{StaticResource ConnectorSize}"
                Height="{StaticResource ConnectorSize}"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Cursor="Hand"
                Fill="Transparent"
                MouseLeftButtonDown="Connector_MouseDown"
                Stroke="{StaticResource ConnectorStroke}"
                StrokeThickness="1" />

            <!--  右侧中心  -->
            <Ellipse
                x:Name="RightConnector"
                Width="{StaticResource ConnectorSize}"
                Height="{StaticResource ConnectorSize}"
                Margin="0,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Cursor="Hand"
                Fill="Transparent"
                MouseLeftButtonDown="Connector_MouseDown"
                Stroke="{StaticResource ConnectorStroke}"
                StrokeThickness="1" />
        </Grid>
        <TextBlock
            x:Name="ItemTextBlock"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="Consolas"
            FontSize="14"
            FontWeight="Bold"
            Foreground="White"
            Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
    </Grid>
</UserControl>