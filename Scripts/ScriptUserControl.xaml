<UserControl
    x:Class="ImageHandle.Scripts.ScriptUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ImageHandle.Scripts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Width="140"
    Height="40"
    MinWidth="140"
    MinHeight="40"
    d:DesignHeight="40"
    d:DesignWidth="140"
    Background="Transparent"
    MouseDown="UserControl_MouseDown"
    MouseMove="UserControl_MouseMove"
    MouseUp="UserControl_MouseUp"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ConnectorStroke" Color="White" />
        <sys:Double x:Key="ConnectorSize">5</sys:Double>
        <Style x:Key="ConnectorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="{StaticResource ConnectorSize}" />
            <Setter Property="Height" Value="{StaticResource ConnectorSize}" />
            <Setter Property="Margin" Value="-1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Fill" Value="{StaticResource ConnectorStroke}" />
            <Setter Property="Stroke" Value="{StaticResource ConnectorStroke}" />
            <Setter Property="StrokeThickness" Value="2" />
            <EventSetter Event="MouseLeftButtonDown" Handler="Connector_MouseDown" />
        </Style>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <!-- 边框 -->
        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="DarkSlateGray"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="10" />
        <!-- 中心点圆形 -->
        <Grid>
            <!-- 顶部中心 -->
            <Ellipse
                x:Name="TopConnector"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Style="{StaticResource ConnectorStyle}" />
            <!-- 底部中心 -->
            <Ellipse
                x:Name="BottomConnector"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Style="{StaticResource ConnectorStyle}" />

            <!-- 左侧中心 -->
            <Ellipse
                x:Name="LeftConnector"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Style="{StaticResource ConnectorStyle}" />

            <!-- 右侧中心 -->
            <Ellipse
                x:Name="RightConnector"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource ConnectorStyle}" />
        </Grid>
        <TextBlock
            x:Name="ItemTextBlock"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="Consolas"
            FontSize="12"
            FontWeight="Bold"
            Foreground="White"
            Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
    </Grid>
</UserControl>