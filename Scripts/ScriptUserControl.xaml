<UserControl
    x:Class="ImageHandle.Scripts.ScriptUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ImageHandle.Scripts"
    Width="160"
    Height="40"
    MinWidth="160"
    MinHeight="40"
    d:DesignHeight="40"
    d:DesignWidth="160"
    MouseDown="UserControl_MouseDown"
    MouseMove="UserControl_MouseMove"
    MouseUp="UserControl_MouseUp"
    mc:Ignorable="d">
    <Grid>
        <!-- 矩形框 -->
        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderBrush="Black"
            BorderThickness="1" />
        <!-- 中心点圆形（透明） -->
        <Grid>
            <!-- 顶部中心 -->
            <Ellipse
                x:Name="TopConnector"
                Width="4"
                Height="4"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Fill="Transparent"
                Stroke="Red"
                StrokeThickness="1"
                Cursor="Hand"
                MouseLeftButtonDown="Connector_MouseDown" />

            <!-- 底部中心 -->
            <Ellipse
                x:Name="BottomConnector"
                Width="4"
                Height="4"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Fill="Transparent"
                Stroke="Red"
                StrokeThickness="1"
                Cursor="Hand"
                MouseLeftButtonDown="Connector_MouseDown" />

            <!-- 左侧中心 -->
            <Ellipse
                x:Name="LeftConnector"
                Width="4"
                Height="4"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Fill="Transparent"
                Stroke="Red"
                StrokeThickness="1"
                Cursor="Hand"
                MouseLeftButtonDown="Connector_MouseDown" />

            <!-- 右侧中心 -->
            <Ellipse
                x:Name="RightConnector"
                Width="4"
                Height="4"
                Margin="0,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Fill="Transparent"
                Stroke="Red"
                StrokeThickness="1"
                Cursor="Hand"
                MouseLeftButtonDown="Connector_MouseDown" />
        </Grid>
        <TextBlock
            x:Name="ItemTextBlock"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
            FontSize="15"
            Foreground="White"
            FontWeight="Bold" />
    </Grid>
</UserControl>