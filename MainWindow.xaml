<Window
    x:Class="ImageHandle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ImageHandle"
    xmlns:converter="clr-namespace:ImageHandle.Converters"
    xmlns:models="clr-namespace:ImageHandle.Models"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:controls="clr-namespace:ImageHandle.Controls"
    Title="MainWindow"
    Width="1610"
    Height="884"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    mc:Ignorable="d">
    <Window.Resources>
        <converter:WindowStatesToContentConverter x:Key="windowStateConverter" />
        <converter:EnumToDescriptionConverter x:Key="enumDesConverter" />
        <converter:EnumFirstToBoolConverter x:Key="enumFirstToBoolConverter" />
        <ObjectDataProvider x:Key="PageEnumValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:PageEnum" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <!--#region 隐藏标题栏-->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <!--#endregion-->
    <Grid>
        <!--#region 设置主界面的背景色-->
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Offset="0" Color="#ff285173" />
                <GradientStop Offset="0.5" Color="#244967" />
                <GradientStop Offset="1" Color="#ff14273a" />
            </RadialGradientBrush>
        </Grid.Background>
        <!--#endregion-->

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <!--#region 标题栏-->
        <!-- 显示间隔线 -->
        <Border Grid.Row="0" BorderBrush="#11aabd" BorderThickness="0,0,0,1" />
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="/Resource/Images/image_512px.png" Stretch="Uniform" />
            <TextBlock
                Grid.Column="1"
                Margin="5,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="图像处理系统"
                FontSize="24"
                FontWeight="Bold"
                Foreground="White" />
            <StackPanel
                Grid.Column="2"
                Height="50"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    x:Name="minBtn"
                    Content="&#xe624;"
                    Style="{StaticResource TitleBtnStyle}"
                    Click="minBtn_Click" />
                <Button
                    x:Name="maxBtn"
                    Content="{Binding WindowState, Converter={StaticResource windowStateConverter}}"
                    Style="{StaticResource TitleBtnStyle}"
                    Click="maxBtn_Click" />
                <Button
                    x:Name="closeBtn"
                    Content="&#xe611;"
                    Style="{StaticResource TitleBtnStyle}"
                    Click="closeBtn_Click" />
            </StackPanel>
        </Grid>
        <!--#endregion-->

        <!--#region 主界面-->
        <Grid Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <!--#region 左侧菜单栏-->
                <Border Grid.Column="0" BorderBrush="#11aabd" BorderThickness="0,0,1,0" />
                <StackPanel Grid.Column="0" Margin="0,5,0,0" Orientation="Vertical">
                    <ItemsControl ItemsSource="{Binding Source={StaticResource PageEnumValues}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton
                                    Style="{StaticResource MenuBtnStyle}"
                                    Content="{Binding Path=., Converter={StaticResource enumDesConverter}}"
                                    IsChecked="{Binding Path=., Converter={StaticResource enumFirstToBoolConverter}}"
                                    CommandParameter="{Binding Path=.}"
                                    Command="{Binding DataContext.NavigationViewModel.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    GroupName="PageEnumGroup" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!--#endregion-->

                <!--#region 右侧主界面-->
                <!--<ContentPresenter Grid.Column="1" Content="{Binding NavigationViewModel.CurrentPage}" />-->
                <controls:TransitionContentControl
                    Grid.Column="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{Binding NavigationViewModel.CurrentPage}"
                    FadeDuration="1000" />
                <!--#endregion-->
            </Grid>
        </Grid>
        <!--#endregion-->

        <!--#region 底部栏-->
        <Border Grid.Row="2" BorderBrush="#11aabd" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderThickness="0,1,0,0" BorderBrush="#5518aabd">
                    <Border.Background>
                        <VisualBrush TileMode="FlipXY" Viewport="0,0,7,7" ViewportUnits="Absolute">
                            <VisualBrush.Visual>
                                <Line
                                    X1="0"
                                    Y1="10"
                                    X2="10"
                                    Y2="0"
                                    Stroke="Gray"
                                    StrokeThickness="1">
                                </Line>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="YYY版权所属"
                    FontSize="14"
                    Foreground="White" />
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</Window>