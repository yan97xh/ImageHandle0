<UserControl
    x:Class="ImageHandle.UserControls.NumberSelectorUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ImageHandle.UserControls"
    x:Name="uc"
    d:DesignHeight="40"
    d:DesignWidth="200"
    mc:Ignorable="d">
    <Border
        Padding="{Binding Padding, ElementName=uc}"
        Background="{Binding Background, ElementName=uc}"
        BorderBrush="{Binding BorderBrush, ElementName=uc}"
        BorderThickness="{Binding BorderThickness, ElementName=uc}"
        CornerRadius="{Binding CornerRadius, ElementName=uc}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 减少按钮 -->
            <Button
                x:Name="DecreaseButton"
                Grid.Column="0"
                Width="30"
                Margin="0,0,5,0"
                Content="-"
                Click="DecreaseButton_Click" />

            <!-- 数值显示 -->
            <TextBox
                x:Name="ValueTextBox"
                Grid.Column="1"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Text="{Binding Value, ElementName=uc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PreviewTextInput="ValueTextBox_PreviewTextInput"
                DataObject.Pasting="ValueTextBox_Pasting" />

            <!-- 增加按钮 -->
            <Button
                x:Name="IncreaseButton"
                Grid.Column="2"
                Width="30"
                Margin="5,0,0,0"
                Content="+"
                Click="IncreaseButton_Click" />
        </Grid>
    </Border>
</UserControl>