<UserControl
    x:Class="ImageHandle.UserControls.MorphologicalOperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ImageHandle.UserControls"
    xmlns:vm="clr-namespace:ImageHandle.ViewModels"
    xmlns:cvert="clr-namespace:ImageHandle.Converters"
    Width="1450"
    Height="840"
    d:DesignHeight="840"
    d:DesignWidth="1450"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:MorphologicalViewModel />
    </UserControl.DataContext>
    <Grid Background="Transparent">
        <!--#region 行列定义-->
        <Grid.RowDefinitions>
            <RowDefinition Height="414" />
            <RowDefinition Height="426" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>
        <!--#endregion-->
        <!--#region 第一列-->
        <StackPanel
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Orientation="Vertical">
            <ItemsControl Margin="20,50,0,0" ItemsSource="{Binding Operations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#11aabd" BorderThickness="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Width="120"
                                    Style="{StaticResource ImgOperateBtnStyle}"
                                    Content="{Binding DisplayName}"
                                    Command="{Binding DataContext.MorphologicalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding operation}"
                                    ToolTip="{Binding Remark}"
                                    FontSize="16" />
                                <ItemsControl ItemsSource="{Binding ParamValueList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    Width="100"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding ParamDisplayName}"
                                                    FontSize="14"
                                                    Foreground="White"
                                                    TextAlignment="Center" />
                                                <TextBox
                                                    Width="40"
                                                    Margin="5,0,5,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    TextAlignment="Center"
                                                    Text="{Binding ParamValue}"
                                                    ToolTip="{Binding Remark}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding ParamBoolList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                <CheckBox
                                                    Width="150"
                                                    Margin="8,0,7,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Content="{Binding ParamDisplayName}"
                                                    Style="{StaticResource CustomCheckBoxStyle}"
                                                    IsChecked="{Binding ParamValue}"
                                                    ToolTip="{Binding Remark}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding ParamEnumList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    Width="100"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding ParamDisplayName}"
                                                    FontSize="14"
                                                    Foreground="White"
                                                    TextAlignment="Center" />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    Width="100"
                                                    Height="25"
                                                    Margin="0,0,5,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsEditable="False"
                                                    ItemsSource="{Binding ItemsArray}"
                                                    SelectedIndex="0"
                                                    Style="{StaticResource ParameterizedComboBoxStyle}"
                                                    Background="#495660"
                                                    BorderBrush="White"
                                                    Foreground="White"
                                                    ToolTip="{Binding Remark}"
                                                    Text="{Binding ParamValue, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style>
                        <Setter Property="Control.Margin" Value="0,10,20,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </StackPanel>
        <!--#endregion-->
        <!--#region 第二列-->
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Height="414"
            BorderThickness="1,0,0,1"
            BorderBrush="#11aabd" />
        <local:SrcImgShowUserControl
            x:Name="srcImgControl"
            Grid.Row="0"
            Grid.Column="1"
            Margin="0"
            VerticalAlignment="Top"
            LabelText="输入图像"
            SrcImageSource="{Binding SrcImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Height="430"
            BorderThickness="1,0,0,0"
            BorderBrush="#11aabd" />
        <local:DstImgShowUserControl
            x:Name="dstImgUserControl"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            DstImageSource="{Binding DstMat, Mode=TwoWay}" />
        <!--#endregion-->
    </Grid>
</UserControl>