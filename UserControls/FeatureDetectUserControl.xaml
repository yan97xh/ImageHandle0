<UserControl
    x:Class="ImageHandle.UserControls.FeatureDetectUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ImageHandle.UserControls"
    xmlns:vm="clr-namespace:ImageHandle.ViewModels"
    xmlns:cvert="clr-namespace:ImageHandle.Converters"
    Width="1450"
    Height="840"
    d:DesignHeight="840"
    d:DesignWidth="1450"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:FeatureDetectViewModel />
    </UserControl.DataContext>
    <Grid Background="Transparent">
        <!--#region 行列定义-->
        <Grid.RowDefinitions>
            <RowDefinition Height="414" />
            <RowDefinition Height="426" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>
        <!--#endregion-->
        <!--#region 第一列-->
        <StackPanel
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Orientation="Vertical">
            <ItemsControl Margin="20,50,0,0" ItemsSource="{Binding Operations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#11aabd" BorderThickness="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Width="120"
                                    Style="{StaticResource ImgOperateBtnStyle}"
                                    Content="{Binding DisplayName}"
                                    Command="{Binding DataContext.ProcessOperationsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding operation}"
                                    ToolTip="{Binding Remark}" />
                                <ItemsControl ItemsSource="{Binding ParamValueList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    Width="80"
                                                    Margin="7,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding ParamDisplayName}"
                                                    FontSize="14"
                                                    Foreground="White"
                                                    TextAlignment="Center" />
                                                <TextBox
                                                    Width="50"
                                                    Margin="2,0,7,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    TextAlignment="Center"
                                                    Text="{Binding ParamValue}"
                                                    ToolTip="{Binding Remark}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding ParamBoolList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                <CheckBox
                                                    Width="150"
                                                    Margin="8,0,7,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Content="{Binding ParamDisplayName}"
                                                    Style="{StaticResource CustomCheckBoxStyle}"
                                                    IsChecked="{Binding ParamValue}"
                                                    ToolTip="{Binding Remark}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style>
                        <Setter Property="Control.Margin" Value="0,10,20,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
            <!--#region 角点提取-->
            <StackPanel Margin="20,10,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="7,0,0,0"
                    VerticalAlignment="Center"
                    Text="角点提取方式:"
                    FontSize="20"
                    Foreground="White" />
                <ComboBox
                    Width="120"
                    Height="25"
                    Margin="10,0,10,0"
                    Padding="5,2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsEditable="False"
                    ItemsSource="{Binding FeatureDetectPointModel.ItemsArray}"
                    SelectedIndex="0"
                    Style="{StaticResource ParameterizedComboBoxStyle}"
                    Background="#495660"
                    BorderBrush="White"
                    Foreground="White"
                    Text="{Binding FeatureDetectPointModel.InputParam, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Text="角点数量:"
                    FontSize="20"
                    Foreground="White" />
                <TextBlock
                    MinWidth="80"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    Text="{Binding FeatureDetectPointModel.PointsCount}"
                    FontSize="20"
                    Foreground="White" />
                <Button
                    Width="120"
                    Height="35"
                    Margin="25,5,10,5"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="角点提取"
                    Command="{Binding ProcessFeatureDetectPointCommand}" />
            </StackPanel>
            <Border Margin="20,5" BorderBrush="#11aabd" BorderThickness="0,0,0,2" />
            <!--#endregion-->
            <!--#region HSV范围提取-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="0.78*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <!--#region H-->
                    <StackPanel Margin="20,10,20,0" Orientation="Horizontal">
                        <TextBlock
                            Width="80"
                            Margin="7,0,0,0"
                            Text="色调"
                            Foreground="White"
                            FontSize="18"
                            TextAlignment="Center" />
                        <TextBlock
                            Width="50"
                            Margin="20,0,0,0"
                            Text="H_min"
                            Foreground="White"
                            FontSize="16"
                            TextAlignment="Center" />
                        <Slider
                            x:Name="h_min_slider"
                            Width="100"
                            Margin="10,2,0,0"
                            Minimum="0"
                            Maximum="180"
                            Value="{Binding H_min, Mode=TwoWay}" />
                        <TextBlock
                            Width="55"
                            Margin="20,0,0,0"
                            Text="H_max"
                            Foreground="White"
                            FontSize="16"
                            TextAlignment="Center" />
                        <Slider
                            x:Name="h_max_slider"
                            Width="100"
                            Margin="10,2,0,0"
                            Minimum="0"
                            Maximum="180"
                            Value="{Binding H_max, Mode=TwoWay}" />
                        <TextBlock
                            Margin="20,0,0,0"
                            Foreground="White"
                            FontSize="16"
                            TextAlignment="Center">
                            <Run Text="{Binding H_min}" />
                            <Run Text="-" />
                            <Run Text="{Binding H_max}" />
                        </TextBlock>
                    </StackPanel>
                    <!--#endregion-->
                    <!--#region S-->
                    <StackPanel Margin="20,10,20,0" Orientation="Horizontal">
                        <TextBlock
                            Width="80"
                            Margin="7,0,0,0"
                            Text="饱和度"
                            Foreground="White"
                            FontSize="18"
                            TextAlignment="Center" />
                        <TextBlock
                            Width="50"
                            Margin="20,0,0,0"
                            Text="S_min"
                            Foreground="White"
                            FontSize="16"
                            TextAlignment="Center" />
                        <Slider
                            x:Name="s_min_slider"
                            Width="100"
                            Margin="10,2,0,0"
                            Minimum="0"
                            Maximum="255"
                            Value="{Binding S_min, Mode=TwoWay}" />
                        <TextBlock
                            Width="55"
                            Margin="20,0,0,0"
                            Text="S_max"
                            Foreground="White"
                            FontSize="16"
                            TextAlignment="Center" />
                        <Slider
                            x:Name="s_max_slider"
                            Width="100"
                            Margin="10,2,0,0"
                            Minimum="0"
                            Maximum="255"
                            Value="{Binding S_max, Mode=TwoWay}" />
                        <TextBlock
                            Margin="20,0,0,0"
                            Foreground="White"
                            FontSize="16"
                            TextAlignment="Center">
                            <Run Text="{Binding S_min}" />
                            <Run Text="-" />
                            <Run Text="{Binding S_max}" />
                        </TextBlock>
                    </StackPanel>
                    <!--#endregion-->
                    <!--#region V-->
                    <StackPanel Margin="20,10,20,0" Orientation="Horizontal">
                        <TextBlock
                            Width="80"
                            Margin="7,0,0,0"
                            Text="亮度"
                            Foreground="White"
                            FontSize="18"
                            TextAlignment="Center" />
                        <TextBlock
                            Width="50"
                            Margin="20,0,0,0"
                            Text="V_min"
                            Foreground="White"
                            FontSize="16"
                            TextAlignment="Center" />
                        <Slider
                            x:Name="v_min_slider"
                            Width="100"
                            Margin="10,2,0,0"
                            Minimum="0"
                            Maximum="255"
                            Value="{Binding V_min, Mode=TwoWay}" />
                        <TextBlock
                            Width="55"
                            Margin="20,0,0,0"
                            Text="V_max"
                            Foreground="White"
                            FontSize="16"
                            TextAlignment="Center" />
                        <Slider
                            x:Name="v_max_slider"
                            Width="100"
                            Margin="10,2,0,0"
                            Minimum="0"
                            Maximum="255"
                            Value="{Binding V_max, Mode=TwoWay}" />
                        <TextBlock
                            Margin="20,0,0,0"
                            Foreground="White"
                            FontSize="16"
                            TextAlignment="Center">
                            <Run Text="{Binding V_min}" />
                            <Run Text="-" />
                            <Run Text="{Binding V_max}" />
                        </TextBlock>
                    </StackPanel>
                    <!--#endregion-->
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Width="120"
                        Height="35"
                        Margin="25,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource ImgOperateBtnStyle}"
                        Content="HSV范围颜色"
                        Command="{Binding ShowHSVRangeWindowCommand}"
                        FontSize="16" />
                    <Button
                        Width="120"
                        Height="35"
                        Margin="25,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource ImgOperateBtnStyle}"
                        Content="HSV范围提取"
                        Command="{Binding HSVRangeDetectCommand}"
                        FontSize="16" />
                </StackPanel>
            </Grid>
            <Border Margin="20,10" BorderBrush="#11aabd" BorderThickness="0,0,0,2" />
            <!--#endregion-->
        </StackPanel>
        <!--#endregion-->
        <!--#region 第二列-->
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Height="414"
            BorderThickness="1,0,0,1"
            BorderBrush="#11aabd" />
        <local:SrcImgShowUserControl
            x:Name="srcImgControl"
            Grid.Row="0"
            Grid.Column="1"
            Margin="0"
            VerticalAlignment="Top"
            LabelText="输入图像"
            SrcImageSource="{Binding SrcImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Height="430"
            BorderThickness="1,0,0,0"
            BorderBrush="#11aabd" />
        <local:DstImgShowUserControl
            x:Name="dstImgUserControl"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            DstImageSource="{Binding DstMat, Mode=TwoWay}" />
        <!--#endregion-->
    </Grid>
</UserControl>