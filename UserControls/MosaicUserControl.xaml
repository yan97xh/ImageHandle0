<UserControl
    x:Class="ImageHandle.UserControls.MosaicUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ImageHandle.UserControls"
    xmlns:vm="clr-namespace:ImageHandle.ViewModels"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cvert="clr-namespace:ImageHandle.Converters"
    Width="1450"
    Height="840"
    d:DesignHeight="840"
    d:DesignWidth="1450"
    mc:Ignorable="d">
    <UserControl.Resources>
        <cvert:ColorToBrushConverter x:Key="colorConverter" />
        <cvert:MatToImageSourceConverter x:Key="matToImageSource" />
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Margin" Value="20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Resources>
    <UserControl.DataContext>
        <vm:MosaicViewModel />
    </UserControl.DataContext>
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="0.6*" />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Row="0"
            Grid.Column="0"
            BorderThickness="0,0,2,0"
            BorderBrush="#11aabd" />
        <!--#region 第一列-->
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <StackPanel Margin="20,10" Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}" Text="输入图像:" />
                <TextBox
                    Width="600"
                    Margin="0,2,0,2"
                    HorizontalAlignment="Center"
                    Text="{Binding SrcImgPath, Mode=TwoWay}"
                    IsReadOnly="True"
                    Background="Transparent"
                    FontSize="18"
                    Foreground="White"
                    TextAlignment="Center" />
                <Button
                    Width="100"
                    Height="30"
                    Margin="30,0,0,0"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="选择图像"
                    Command="{Binding SelectSrcImgCommand}" />
            </StackPanel>
            <Image
                Name="TargetImage"
                Grid.Row="1"
                Width="760"
                Height="720"
                Source="{Binding MainMat, Converter={StaticResource matToImageSource}, Mode=TwoWay}"
                Stretch="Fill">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding MouseDownCommand}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseUp">
                        <i:InvokeCommandAction Command="{Binding MouseUpCommand}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseMove">
                        <i:InvokeCommandAction Command="{Binding MouseMoveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Image}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Image>
            <StackPanel Margin="20,10,20,0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}" Text="保存图像:" />
                <TextBox
                    Width="600"
                    Margin="0,2,0,2"
                    HorizontalAlignment="Center"
                    Text="{Binding SaveImagePath, Mode=TwoWay}"
                    IsReadOnly="True"
                    Background="Transparent"
                    FontSize="18"
                    Foreground="White"
                    TextAlignment="Center" />
                <Button
                    Width="100"
                    Height="30"
                    Margin="30,0,0,0"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="保存图像"
                    Command="{Binding SaveImageCommand}" />
            </StackPanel>
        </StackPanel>
        <!--#endregion-->
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <StackPanel Margin="20" Orientation="Horizontal">
                <CheckBox
                    Style="{StaticResource CustomCheckBoxStyle}"
                    Content="启用马赛克"
                    FontSize="20"
                    IsChecked="{Binding IsMosaicEnabled, Mode=TwoWay}" />
                <TextBlock Margin="100,0,0,0" Style="{StaticResource LabelText}" Text="马赛克大小:" />
                <ComboBox
                    Width="80"
                    Height="30"
                    Margin="20,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#495660"
                    BorderBrush="White"
                    Foreground="White"
                    IsEditable="False"
                    SelectedIndex="0"
                    Style="{StaticResource ParameterizedComboBoxStyle}"
                    ItemsSource="{Binding MosaicSizeItemsArray}"
                    Text="{Binding MosaicSize, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="20" Orientation="Horizontal">
                <Button Style="{StaticResource ImgOperateBtnStyle}" Content="图像复原" Command="{Binding RecoverCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>