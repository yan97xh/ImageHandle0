<UserControl
    x:Class="ImageHandle.UserControls.ROIInsertUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ImageHandle.UserControls"
    xmlns:vm="clr-namespace:ImageHandle.ViewModels"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cvert="clr-namespace:ImageHandle.Converters"
    xmlns:roi="clr-namespace:ImageHandle.ROI"
    Width="1450"
    Height="840"
    d:DesignHeight="840"
    d:DesignWidth="1450"
    mc:Ignorable="d">
    <UserControl.Resources>
        <cvert:ColorToBrushConverter x:Key="colorConverter" />
        <cvert:MatToImageSourceConverter x:Key="matToImageSource" />
        <cvert:BoolToVisibility x:Key="boolToVisibility" />
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Margin" Value="20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="0.6*" />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Row="0"
            Grid.Column="0"
            BorderThickness="0,0,2,0"
            BorderBrush="#11aabd" />

        <!--#region 第一列-->
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <StackPanel Margin="20,10" Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}" Text="输入图像:" />
                <TextBox
                    Width="600"
                    Margin="0,2,0,2"
                    HorizontalAlignment="Center"
                    Text="{Binding SrcImgPath, Mode=TwoWay}"
                    IsReadOnly="True"
                    Background="Transparent"
                    FontSize="18"
                    Foreground="White"
                    TextAlignment="Center" />
                <Button
                    Width="100"
                    Height="30"
                    Margin="30,0,0,0"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="选择图像"
                    Command="{Binding SelectSrcImgCommand}" />
            </StackPanel>
            <Grid Width="800" Height="710">
                <Image
                    Name="TargetImage"
                    Width="730"
                    Height="700"
                    Source="{Binding LastMat, Converter={StaticResource matToImageSource}, Mode=TwoWay}"
                    Stretch="Fill">
                </Image>
                <roi:ROICanvas
                    Width="730"
                    Height="700"
                    Visibility="{Binding IsROIDetectEnabled, Converter={StaticResource boolToVisibility}}"
                    Background="Transparent"
                    RecantangleBrush="{Binding ROIRectangleColor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    BottomRightP="{Binding BottomRightP, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    TopLeftP="{Binding TopLeftP, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            </Grid>
            <StackPanel Margin="20,20" Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}" Text="保存图像:" />
                <TextBox
                    Width="600"
                    Margin="0,2,0,2"
                    HorizontalAlignment="Center"
                    Text="{Binding SaveImagePath, Mode=TwoWay}"
                    IsReadOnly="True"
                    Background="Transparent"
                    FontSize="18"
                    Foreground="White"
                    TextAlignment="Center" />
                <Button
                    Width="100"
                    Height="30"
                    Margin="30,0,0,0"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="保存图像"
                    Command="{Binding SaveImageCommand}" />
            </StackPanel>
        </StackPanel>
        <!--#endregion-->

        <!--#region 第二列-->
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <StackPanel Margin="20" Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}" Text="ROI边框颜色:" />
                <Border
                    Width="80"
                    Height="30"
                    Margin="0,0"
                    VerticalAlignment="Center"
                    BorderThickness="1"
                    BorderBrush="Black"
                    Background="{Binding ROIRectangleColor, Mode=TwoWay}">
                    <!--#region 行为-->
                    <!-- 上下实现效果一样 -->
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding ProcessROIRectangleColorCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <!--#endregion-->
                </Border>
                <Button
                    Width="100"
                    Height="40"
                    Margin="30,0,0,0"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="初始化ROI"
                    Command="{Binding InitROICommand}">
                    <Button.CommandParameter>
                        <Point X="365" Y="350" />
                    </Button.CommandParameter>
                </Button>
                <Button
                    Width="100"
                    Height="40"
                    Margin="30,0,0,0"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="清空ROI"
                    Command="{Binding ClearROICommand}">
                </Button>
            </StackPanel>
            <Border BorderThickness="0,2,0,0" BorderBrush="#11aabd" />
            <StackPanel Margin="20" Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}">
                    <!--<TextBlock.LayoutTransform>
                        <RotateTransform Angle="270" />
                    </TextBlock.LayoutTransform>-->
                    <Run>插</Run>
                    <LineBreak />
                    <Run>入</Run>
                    <LineBreak />
                    <Run>图</Run>
                    <LineBreak />
                    <Run>像</Run>
                </TextBlock>
                <Image
                    Width="250"
                    Height="250"
                    Margin="10"
                    Source="{Binding InsertMat, Converter={StaticResource matToImageSource}, Mode=TwoWay}"
                    Stretch="Fill" />
                <Button
                    Margin="20,0"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="选择插入图像"
                    Command="{Binding SelectInsertImgCommand}" />
            </StackPanel>
            <Border BorderThickness="0,2,0,0" BorderBrush="#11aabd" />
            <StackPanel Margin="20" Orientation="Horizontal">
                <Button
                    Margin="20,10"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="插入图像"
                    Command="{Binding InsertImageCommand}" />
                <Button
                    Margin="20,10"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="撤销"
                    Command="{Binding ProcessRevocationCommand}" />
                <Button
                    Margin="20,10"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="复位"
                    Command="{Binding RecoverCommand}" />
            </StackPanel>
        </StackPanel>
        <!--#endregion-->
    </Grid>
</UserControl>