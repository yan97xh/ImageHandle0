<UserControl
    x:Class="ImageHandle.UserControls.FaceRecognitionUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ImageHandle.UserControls"
    xmlns:vm="clr-namespace:ImageHandle.ViewModels"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cvert="clr-namespace:ImageHandle.Converters"
    Width="1450"
    Height="840"
    d:DesignHeight="840"
    d:DesignWidth="1450"
    mc:Ignorable="d">
    <UserControl.Resources>
        <cvert:MatToImageSourceConverter x:Key="matToImageSource" />
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Margin" Value="20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style x:Key="CoordinateDisplayStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="5" />
        </Style>

        <Style x:Key="SelectedCoordinateStyle" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedCoordinate.IsSelected}" Value="True">
                    <Setter Property="Background" Value="LightGreen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type vm:FileSystemItem}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="Normal" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="DarkBlue" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                <Setter Property="Foreground" Value="Black" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="0.6*" />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Row="0"
            Grid.Column="0"
            BorderThickness="0,0,2,0"
            BorderBrush="#11aabd" />
        <!--#region 第一列-->
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <StackPanel Margin="20,10" Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}" Text="输入图像:" />
                <TextBox
                    Width="600"
                    Margin="0,2,0,2"
                    HorizontalAlignment="Center"
                    Text="{Binding SrcImgPath, Mode=TwoWay}"
                    IsReadOnly="True"
                    Background="Transparent"
                    FontSize="18"
                    Foreground="White"
                    TextAlignment="Center" />
                <Button
                    Width="100"
                    Height="30"
                    Margin="30,0,0,0"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="选择图像"
                    Command="{Binding SelectSrcImgCommand}" />
            </StackPanel>
            <Image
                Name="TargetImage"
                Grid.Row="1"
                Width="760"
                Height="720"
                Source="{Binding LastMat, Converter={StaticResource matToImageSource}, Mode=TwoWay}"
                Stretch="Fill">
            </Image>
            <StackPanel Margin="20,10,20,0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}" Text="保存图像:" />
                <TextBox
                    Width="600"
                    Margin="0,2,0,2"
                    HorizontalAlignment="Center"
                    Text="{Binding SaveImagePath, Mode=TwoWay}"
                    IsReadOnly="True"
                    Background="Transparent"
                    FontSize="18"
                    Foreground="White"
                    TextAlignment="Center" />
                <Button
                    Width="100"
                    Height="30"
                    Margin="30,0,0,0"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="保存图像"
                    Command="{Binding SaveImageCommand}" />
            </StackPanel>
        </StackPanel>
        <!--#endregion-->
        <!--#region 第二列-->
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Image
                    Width="320"
                    Height="320"
                    Margin="20"
                    Source="{Binding TrainMat, Converter={StaticResource matToImageSource}, Mode=TwoWay}"
                    Stretch="Fill" />
                <StackPanel Orientation="Vertical">
                    <Button
                        Margin="20"
                        Style="{StaticResource ImgOperateBtnStyle}"
                        Content="选择训练图片"
                        Command="{Binding SelectTrainImgCommand}" />
                    <TextBlock Style="{StaticResource LabelText}" Text="训练集分组:" FontSize="16" />
                    <local:NumberSelectorUserControl
                        Width="140"
                        Height="30"
                        Margin="20,10"
                        Minimum="1"
                        Maximum="100"
                        Step="1"
                        BorderBrush="DarkBlue"
                        CornerRadius="5"
                        Value="{Binding TrainGroupId, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource LabelText}" Text="训练集人名:" FontSize="16" />
                    <TextBox
                        Width="140"
                        Margin="20,10"
                        FontSize="16"
                        TextAlignment="Center"
                        Text="{Binding TrainGroupName, Mode=TwoWay}" />
                    <Button
                        Margin="20"
                        Style="{StaticResource ImgOperateBtnStyle}"
                        Content="添加训练图片"
                        Command="{Binding AddTrainImageCommand}" />
                </StackPanel>
            </StackPanel>
            <Border BorderThickness="0,0,0,2" BorderBrush="#11aabd" />
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="10,10"
                        Style="{StaticResource LabelText}"
                        Text="训练集路径:"
                        FontSize="16" />
                    <TextBlock
                        Width="330"
                        Margin="5,10"
                        Style="{StaticResource LabelText}"
                        Text="{Binding TrainInfoPath}"
                        Foreground="White"
                        FontSize="16" />
                    <Button
                        Width="80"
                        Height="30"
                        Margin="5,10"
                        HorizontalAlignment="Left"
                        Style="{StaticResource ImgOperateBtnStyle}"
                        FontSize="14"
                        Command="{Binding ChangeTrainPathCommand}"
                        Content="更换训练集" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TreeView
                        x:Name="TreeTrainMsg"
                        Width="200"
                        Height="200"
                        Margin="10"
                        ItemsSource="{Binding TrainPathItems}"
                        SelectedItemChanged="TreeTrainMsg_SelectedItemChanged"
                        PreviewMouseRightButtonDown="TreeTrainMsg_PreviewMouseRightButtonDown">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <ContextMenu x:Key="FolderContextMenu">
                                <MenuItem Header="重命名" Click="Folder_ReName" />
                                <MenuItem Header="删除" Click="Folder_Delete" />
                            </ContextMenu>
                            <ContextMenu x:Key="FileContextMenu">
                                <MenuItem Header="删除" Click="File_Delete" />
                            </ContextMenu>
                        </TreeView.Resources>
                    </TreeView>
                    <StackPanel Margin="20,0" Orientation="Vertical">
                        <TextBlock Margin="5,20" Style="{StaticResource LabelText}">
                            <Run>图像预览</Run>
                            <LineBreak />
                            <Run FontSize="14">(双击放大查看)</Run>
                        </TextBlock>
                        <Image
                            x:Name="pbxTrainShow"
                            Width="100"
                            Height="100"
                            Source="{Binding PreMat, Converter={StaticResource matToImageSource}, Mode=TwoWay}"
                            MouseLeftButtonDown="pbxTrainShow_MouseLeftButtonDown"
                            Stretch="Fill" />
                    </StackPanel>
                    <StackPanel Margin="30,0" Orientation="Vertical">
                        <Button
                            Margin="5,60,5,10"
                            VerticalAlignment="Center"
                            Style="{StaticResource ImgOperateBtnStyle}"
                            Content="刷新训练集"
                            Command="{Binding RefreshTrainInfoCommand}" />
                        <Button
                            Margin="5,20"
                            VerticalAlignment="Center"
                            Style="{StaticResource ImgOperateBtnStyle}"
                            Content="训练图像"
                            Command="{Binding TrainInfoCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Border BorderThickness="0,0,0,2" BorderBrush="#11aabd" />
            <StackPanel Orientation="Vertical">
                <Button
                    Width="140"
                    Height="60"
                    Margin="70"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="人脸识别"
                    FontSize="22"
                    Command="{Binding FaceRecongnizeCommand}" />
            </StackPanel>
        </StackPanel>
        <!--#endregion-->
    </Grid>
</UserControl>