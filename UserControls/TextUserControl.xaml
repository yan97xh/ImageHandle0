<UserControl
    x:Class="ImageHandle.UserControls.TextUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ImageHandle.UserControls"
    xmlns:vm="clr-namespace:ImageHandle.ViewModels"
    xmlns:cvert="clr-namespace:ImageHandle.Converters"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:be="clr-namespace:ImageHandle.Behaviors"
    xmlns:rule="clr-namespace:ImageHandle.ValidationRules"
    xmlns:ex="clr-namespace:ImageHandle.Extensions"
    xmlns:models="clr-namespace:ImageHandle.Models"
    xmlns:opencv="clr-namespace:OpenCvSharp;assembly=OpenCvSharp"
    Width="1450"
    Height="840"
    d:DesignHeight="840"
    d:DesignWidth="1450"
    mc:Ignorable="d">
    <UserControl.Resources>
        <cvert:ColorToBrushConverter x:Key="colorConverter" />
        <cvert:MatToImageSourceConverter x:Key="matConverter" />
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Margin" Value="20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Resources>
    <UserControl.DataContext>
        <vm:TextViewModel />
    </UserControl.DataContext>
    <Grid Background="Transparent">
        <!--#region 行列定义-->
        <Grid.RowDefinitions>
            <RowDefinition Height="414" />
            <RowDefinition Height="426" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>
        <!--#endregion-->
        <!--#region 第一列-->
        <StackPanel
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Margin="20"
            Orientation="Vertical">
            <!--#region 文字写入-->
            <StackPanel Height="40" Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}" Text="文本颜色:" />
                <Border
                    Width="80"
                    Height="30"
                    Margin="0,0"
                    VerticalAlignment="Center"
                    BorderThickness="1"
                    BorderBrush="Black"
                    Background="{Binding WriteFontColor, Converter={StaticResource colorConverter}, Mode=TwoWay}">
                    <!--#region 行为-->
                    <!--<i:Interaction.Behaviors>
                            <be:MouseClickBehavior Command="{Binding FontColorCommand}" />
                        </i:Interaction.Behaviors>-->
                    <!-- 上下实现效果一样 -->
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding ProcessFontColorCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <!--#endregion-->
                </Border>
                <TextBlock Style="{StaticResource LabelText}" Text="文字大小:" />
                <TextBox
                    Width="70"
                    Height="30"
                    Margin="0,0,0,0"
                    VerticalContentAlignment="Center"
                    TextAlignment="Center"
                    FontSize="20"
                    Background="#495660"
                    Foreground="White">
                    <TextBox.Text>
                        <Binding Path="WriteFontScale">
                            <Binding.ValidationRules>
                                <rule:DoubleValidationRule />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <TextBlock Style="{StaticResource LabelText}" Text="写入位置X:" />
                <TextBox
                    Width="70"
                    Height="30"
                    Margin="0,0,0,0"
                    VerticalContentAlignment="Center"
                    TextAlignment="Center"
                    FontSize="20"
                    Background="#495660"
                    Foreground="White"
                    ToolTip="坐标为文字左下角相对于图片坐标">
                    <TextBox.Text>
                        <Binding Path="LocationX">
                            <Binding.ValidationRules>
                                <rule:IntValidationRule />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <TextBlock Style="{StaticResource LabelText}" Text="写入位置Y:" />
                <TextBox
                    Width="70"
                    Height="30"
                    Margin="0,0,0,0"
                    VerticalContentAlignment="Center"
                    TextAlignment="Center"
                    FontSize="20"
                    Background="#495660"
                    Foreground="White"
                    ToolTip="坐标为文字左下角相对于图片坐标">
                    <TextBox.Text>
                        <Binding Path="LocationY">
                            <Binding.ValidationRules>
                                <rule:IntValidationRule />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </StackPanel>
            <StackPanel Height="40" Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}" Text="文本样式:" />
                <ComboBox
                    Width="160"
                    Height="30"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsEditable="False"
                    ItemsSource="{ex:EnumBindingSource EnumType=opencv:HersheyFonts}"
                    SelectedIndex="0"
                    Style="{StaticResource ParameterizedComboBoxStyle}"
                    Background="#495660"
                    BorderBrush="White"
                    Foreground="White"
                    Text="{Binding FontStyle, UpdateSourceTrigger=PropertyChanged}">
                </ComboBox>
                <TextBlock Style="{StaticResource LabelText}" Text="文本粗细:" />
                <ComboBox
                    Width="60"
                    Height="30"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsEditable="False"
                    ItemsSource="{Binding ThincknessItemsArray}"
                    SelectedIndex="0"
                    Style="{StaticResource ParameterizedComboBoxStyle}"
                    Background="#495660"
                    BorderBrush="White"
                    Foreground="White"
                    Text="{Binding WriteTextThinckness, UpdateSourceTrigger=PropertyChanged}">
                </ComboBox>
                <TextBlock Style="{StaticResource LabelText}" Text="字体预览图:" />
                <Image
                    Width="200"
                    Height="40"
                    Source="{Binding FontShowMat, Converter={StaticResource matConverter}}"
                    Stretch="Fill" />
            </StackPanel>
            <StackPanel Height="80" Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}" Text="写入文本:" />
                <TextBox
                    Width="250"
                    Height="60"
                    Margin="0,0,0,0"
                    VerticalContentAlignment="Center"
                    TextAlignment="Center"
                    FontSize="20"
                    Background="#495660"
                    Foreground="White"
                    Text="{Binding WriteText}" />
                <Button
                    Margin="50,0,0,0"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="文本写入"
                    ToolTip="不支持写入中文!!!"
                    Command="{Binding ProcessWriteTextCommand}" />
            </StackPanel>
            <!--#endregion-->
            <Border BorderThickness="0,0,0,1" BorderBrush="#11aabd" />
            <StackPanel Height="60" Orientation="Horizontal">
                <Button
                    Margin="50,0,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="文本识别"
                    Command="{Binding ProcessOCRCommand}" />
            </StackPanel>
            <Border BorderThickness="0,0,0,1" BorderBrush="#11aabd" />
            <StackPanel Height="80" Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}" Text="二维码信息:" />
                <TextBox
                    Width="250"
                    Height="60"
                    Margin="0,0,0,0"
                    VerticalContentAlignment="Center"
                    TextAlignment="Center"
                    FontSize="20"
                    Background="#495660"
                    Foreground="White"
                    Text="{Binding QRCodeMessage}" />
                <TextBlock Style="{StaticResource LabelText}" Text="二维码颜色:" />
                <Border
                    Width="60"
                    Height="30"
                    Margin="0,0"
                    VerticalAlignment="Center"
                    BorderThickness="1"
                    BorderBrush="Black"
                    Background="{Binding QRCodeColor, Converter={StaticResource colorConverter}, Mode=TwoWay}">
                    <!--#region 行为-->
                    <!--<i:Interaction.Behaviors>
                           <be:MouseClickBehavior Command="{Binding QRCodeColorCommand}" />
                        </i:Interaction.Behaviors>-->
                    <!-- 上下实现效果一样 -->
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding ProcessQRCodeColorCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <!--#endregion-->
                </Border>
                <CheckBox
                    Margin="20,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource CustomCheckBoxStyle}"
                    Content="带白边"
                    FontSize="20"
                    Foreground="White"
                    IsChecked="{Binding BlankSide}" />
                <CheckBox
                    Margin="20,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource CustomCheckBoxStyle}"
                    Content="Logo"
                    FontSize="20"
                    Foreground="White"
                    IsChecked="{Binding Logo}"
                    ToolTip="Logo图像为输入图像" />
                <Button
                    Margin="50,0,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="二维码生成"
                    Command="{Binding QRCodeCreateCommand}" />
            </StackPanel>
            <Border BorderThickness="0,0,0,1" BorderBrush="#11aabd" />
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}" Text="二维码信息:" />
                <TextBox
                    Width="250"
                    Height="70"
                    Margin="0,0,0,0"
                    VerticalContentAlignment="Center"
                    TextAlignment="Center"
                    FontSize="20"
                    Background="#495660"
                    Foreground="White"
                    IsReadOnly="True"
                    Text="{Binding QRCodeDetectMsg}" />
                <Button
                    Margin="50,0,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ImgOperateBtnStyle}"
                    Content="二维码识别"
                    Command="{Binding QRCodeDetectCommand}" />
            </StackPanel>
            <Border BorderThickness="0,0,0,1" BorderBrush="#11aabd" />
        </StackPanel>
        <!--#endregion-->
        <!--#region 第二列-->
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Height="414"
            BorderThickness="1,0,0,1"
            BorderBrush="#11aabd" />
        <local:SrcImgShowUserControl
            x:Name="srcImgControl"
            Grid.Row="0"
            Grid.Column="1"
            Margin="0"
            VerticalAlignment="Top"
            LabelText="输入图像"
            SrcImageSource="{Binding SrcImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Height="430"
            BorderThickness="1,0,0,0"
            BorderBrush="#11aabd" />
        <local:DstImgShowUserControl
            x:Name="dstImgUserControl"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            DstImageSource="{Binding DstMat, Mode=TwoWay}" />
        <!--#endregion-->
    </Grid>
</UserControl>