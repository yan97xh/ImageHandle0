<UserControl
    x:Class="ImageHandle.UserControls.FeatureMatchUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ImageHandle.UserControls"
    xmlns:vm="clr-namespace:ImageHandle.ViewModels"
    xmlns:rule="clr-namespace:ImageHandle.ValidationRules"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ex="clr-namespace:ImageHandle.Extensions"
    xmlns:models="clr-namespace:ImageHandle.Models"
    Width="1450"
    Height="840"
    d:DesignHeight="840"
    d:DesignWidth="1450"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:FeatureMatchViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <ObjectDataProvider x:Key="FeatureMatchModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:FeatureMatchMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <!--#region 行列定义-->
        <Grid.RowDefinitions>
            <RowDefinition Height="414" />
            <RowDefinition Height="426" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <!--#endregion-->
        <!--#region 网格线-->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            BorderThickness="0,0,2,2"
            BorderBrush="#11aabd" />
        <Border
            Grid.Row="0"
            Grid.Column="1"
            BorderThickness="0,0,2,2"
            BorderBrush="#11aabd" />
        <Border
            Grid.Row="0"
            Grid.Column="2"
            BorderThickness="0,0,0,2"
            BorderBrush="#11aabd" />
        <Border
            Grid.Row="1"
            Grid.Column="0"
            BorderThickness="0,0,2,0"
            BorderBrush="#11aabd" />
        <Border
            Grid.Row="1"
            Grid.Column="1"
            BorderThickness="0,0,2,0"
            BorderBrush="#11aabd" />
        <!--#endregion-->
        <!--#region 图像控件-->

        <local:SrcImgShowUserControl
            x:Name="srcImgControl1"
            Grid.Row="0"
            Grid.Column="0"
            Margin="0"
            VerticalAlignment="Top"
            LabelText="输入图像1"
            SrcImageSource="{Binding SrcImagePath1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <local:SrcImgShowUserControl
            x:Name="srcImgControl2"
            Grid.Row="0"
            Grid.Column="1"
            Margin="0"
            VerticalAlignment="Top"
            LabelText="输入图像2"
            SrcImageSource="{Binding SrcImagePath2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <local:DstImgShowUserControl
            x:Name="dstImgUserControl1"
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,0,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            LabelText="特征点图1"
            DstImageSource="{Binding FeatureMatchResModel.FeatureDstMat1, Mode=TwoWay}" />
        <local:DstImgShowUserControl
            x:Name="dstImgUserControl2"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            LabelText="特征点图2"
            DstImageSource="{Binding FeatureMatchResModel.FeatureDstMat2, Mode=TwoWay}" />
        <local:DstImgShowUserControl
            x:Name="dstImgUserControl3"
            Grid.Row="1"
            Grid.Column="2"
            Margin="0,0,0,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            LabelText="特征匹配图"
            DstImageSource="{Binding FeatureMatchResModel.FeatureMatchDstMat, Mode=TwoWay}" />
        <!--#endregion-->
        <!--#region 操作控件-->
        <StackPanel Grid.Row="0" Grid.Column="2">
            <StackPanel Margin="20,50,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="20,5,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="匹配参数:"
                    FontSize="20"
                    Foreground="White" />
                <TextBox
                    Width="120"
                    Margin="40,5,0,0"
                    VerticalContentAlignment="Center"
                    TextAlignment="Center"
                    FontSize="20"
                    Background="#495660"
                    Foreground="White"
                    ToolTip="数值越小,匹配的越多">
                    <TextBox.Text>
                        <Binding Path="MatchDisParam">
                            <Binding.ValidationRules>
                                <rule:DoubleValidationRule />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </StackPanel>
            <StackPanel Margin="20,10,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="20,5,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="匹配器类型:"
                    FontSize="20"
                    Foreground="White" />
                <ComboBox
                    Width="120"
                    Height="30"
                    Margin="20,6,10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsEditable="False"
                    ItemsSource="{ex:EnumBindingSource EnumType=models:MatcherMode}"
                    SelectedIndex="0"
                    Style="{StaticResource ParameterizedComboBoxStyle}"
                    Background="#495660"
                    BorderBrush="White"
                    Foreground="White"
                    Text="{Binding MatcherMode, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Source={StaticResource FeatureMatchModeValues}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="50,20,0,0"
                            Style="{StaticResource ImgOperateBtnStyle}"
                            Content="{Binding Path=.}"
                            CommandParameter="{Binding Path=.}"
                            Command="{Binding DataContext.ProcessFeatureMatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
        <!--#endregion-->
    </Grid>
</UserControl>